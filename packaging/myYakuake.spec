# Fork of Fedora's yakuake.spec: upstream release tarball (keeps translations) plus the
# myYakuake branch diff. Installs under myYakuake names, so it coexists with yakuake.

%global upstream_name yakuake

Name:    myYakuake
Version: 26.08.3
Release: 4%{?dist}
Summary: A drop-down terminal emulator (myYakuake fork)

License: GPL-2.0-only OR GPL-3.0-only
URL: https://github.com/rion0426/myYakuake
Source0: https://download.kde.org/%{stable_kf6}/release-service/%{version}/src/%{upstream_name}-%{version}.tar.xz
# git diff v%%{version}..HEAD, without packaging/ and tests/ (generated by packaging/build.sh)
Patch0:  myYakuake.patch

ExcludeArch: %{ix86}

Requires:       konsole-part%{?_isa} >= %{version}

BuildRequires:  desktop-file-utils
BuildRequires:  extra-cmake-modules
BuildRequires:  gettext
BuildRequires:  kf6-rpm-macros

BuildRequires:  cmake(Qt6Core)
BuildRequires:  cmake(Qt6Widgets)
BuildRequires:  cmake(Qt6Svg)
BuildRequires:  cmake(Qt6Gui)
BuildRequires:  qt6-qtbase-private-devel

BuildRequires:  cmake(KF6Archive)
BuildRequires:  cmake(KF6Config)
BuildRequires:  cmake(KF6CoreAddons)
BuildRequires:  cmake(KF6Crash)
BuildRequires:  cmake(KF6DBusAddons)
BuildRequires:  cmake(KF6GlobalAccel)
BuildRequires:  cmake(KF6I18n)
BuildRequires:  cmake(KF6IconThemes)
BuildRequires:  cmake(KF6KIO)
BuildRequires:  cmake(KF6NewStuff)
BuildRequires:  cmake(KF6Notifications)
BuildRequires:  cmake(KF6NotifyConfig)
BuildRequires:  cmake(KF6Parts)
BuildRequires:  cmake(KF6WidgetsAddons)
BuildRequires:  cmake(KF6WindowSystem)
BuildRequires:  cmake(KF6StatusNotifierItem)
BuildRequires:  cmake(KWayland)
BuildRequires:  cmake(PlasmaWaylandProtocols)
BuildRequires:  xcb-util-devel

%description
Yakuake drop-down terminal with local changes: real fullscreen on Wayland
(covers always-visible panels), a configurable vertical window position and a
choice between slide and fade open/retract animations.


%prep
%autosetup -n %{upstream_name}-%{version} -p1


%build
%cmake_kf6
%cmake_build


%install
%cmake_install
# The upstream catalogs are installed as yakuake.mo, which the yakuake package owns too.
for mo in %{buildroot}%{_datadir}/locale/*/LC_MESSAGES/yakuake.mo; do
    mv "$mo" "${mo%/*}/myyakuake.mo"
done
%find_lang myyakuake


%check
desktop-file-validate %{buildroot}%{_kf6_datadir}/applications/org.kde.myyakuake.desktop


%files -f myyakuake.lang
%doc AUTHORS ChangeLog TODO
%license LICENSES/*
%{_kf6_bindir}/myyakuake
%{_kf6_datadir}/knsrcfiles/myyakuake.knsrc
%{_kf6_datadir}/applications/org.kde.myyakuake.desktop
%{_kf6_datadir}/knotifications6/myyakuake.notifyrc
%{_kf6_datadir}/myyakuake/
%{_kf6_datadir}/icons/hicolor/*/apps/myyakuake.png
%{_kf6_datadir}/dbus-1/services/org.kde.myyakuake.service


%changelog
* Mon Nov 23 2026 rion0426 - 26.08.3-4
- Renamed to myYakuake (binary, app id, D-Bus service, config, data dir, icons,
  translations); no longer replaces yakuake, both can be installed side by side

* Mon Nov 23 2026 rion0426 - 26.08.3-3
- Wayland: one toggle reopens a minimized window with the open animation
- Wayland: no intermediate top-left frame when leaving fullscreen

* Mon Nov 23 2026 rion0426 - 26.08.3-2
- Slide/Fade open animation setting
- Wayland fullscreen: compositor-sized, contents follow resizes, windowed geometry
  restored correctly also after reopening in fullscreen

* Mon Nov 23 2026 rion0426 - 26.08.3-1
- Fork of Fedora yakuake 26.08.3-1: Wayland real fullscreen, vertical position setting
